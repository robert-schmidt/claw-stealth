# ---------------------------------------------------------------------------
# claw-stealth client configuration
# Copy to ".env" and fill in. ".env" is gitignored — never commit it.
# ---------------------------------------------------------------------------

# --- Tunnel endpoint -------------------------------------------------------
# The address the client dials to reach your VPS. setup-server.sh prints the
# correct value at the end of server setup.
#   Reality (direct) mode : the VPS public IP, e.g. 203.0.113.10
#   VLESS+WS+TLS  mode    : your Cloudflare-proxied hostname,
#                           e.g. cdn-edge.example.com
# It is resolved ONCE at container start (before the kill switch is armed) so
# Reality mode leaks zero DNS and WS mode leaks at most one bootstrap lookup.
TUNNEL_SERVER=CHANGE_ME
TUNNEL_PORT=443

# --- AI provider credentials (passed into the claw container) --------------
# claw-code talks to AI providers directly. Fill in ONLY what you use.
#
# Anthropic (Claude) — the default. Get a key at https://console.anthropic.com
#   a normal  sk-ant-...  key  -> ANTHROPIC_API_KEY
#   an OAuth / proxy bearer    -> ANTHROPIC_AUTH_TOKEN
#   These slots are NOT interchangeable — an sk-ant- key in the bearer slot is
#   the #1 cause of 401 errors. ANTHROPIC_BASE_URL is optional (proxy/gateway).
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
#
# OpenAI-compatible: OpenAI, OpenRouter, Google Gemini's OpenAI endpoint, Ollama.
# Set OPENAI_BASE_URL for anything other than OpenAI itself — e.g. OpenRouter:
#   OPENAI_API_KEY=sk-or-v1-...   OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
GEMINI_API_KEY=
#
# xAI (grok) and Alibaba DashScope (qwen), if you use them.
XAI_API_KEY=
DASHSCOPE_API_KEY=

# --- Reliability / privacy feature flags -----------------------------------
# Kill switch: drop every packet that does not leave through the tunnel, so a
# dropped cafe wifi connection can never silently expose your API traffic.
KILL_SWITCH=true

# Auto-reconnect: tear down and re-establish the tunnel on a jittered cycle so
# it survives public wifi that kills long-lived connections.
AUTO_RECONNECT=true
RECONNECT_MIN_MINUTES=45
RECONNECT_MAX_MINUTES=90

# Multiplex + padding: improve throughput on lossy wifi and normalize packet
# sizes. Must be enabled on the server too (it is, by default).
MUX_ENABLED=true

# Time window: restrict tunnel uptime to set hours via cron inside the
# container. 24h "HH:MM", local container time (set TZ to taste).
TIME_WINDOW_ENABLED=false
TIME_WINDOW_START=09:00
TIME_WINDOW_END=23:00
TZ=UTC

# --- Workspace -------------------------------------------------------------
# The project codebase mounted at /workspace inside the claw container.
# Either point this at your project (absolute path or a path relative to this
# directory), or just drop your code into ./workspace.
WORKSPACE_DIR=./workspace

# --- Images / build --------------------------------------------------------
# Pinned sing-box release used by both the tunnel image and server setup.
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box:v1.13.12

# claw-code branch to build. "auto" prefers dev/rust then falls back to main.
CLAW_BRANCH=auto
